<section class="panel folio"><h2>皮重与净量</h2><div class="scroll"><table><thead><tr><th>票号</th><th>容器</th><th>生效皮重</th><th>毛重 g</th><th>皮重 g</th><th>净重 g</th><th>皮重行</th></tr></thead><tbody>{% for r in data.tares.rows %}<tr><th scope="row">{{ r.data.ticket }}</th><td>{{ r.data.container }}</td><td>{{ r.tares[0].data.version }}</td><td>{{ grams(r.gross_mg) }}</td><td>{{ grams(r.tare_mg) }}</td><td>{{ grams(r.net_mg) }}</td><td>{{ r.tares[0].line }}</td></tr>{% endfor %}</tbody></table></div></section>{% include 'rejects.j2' %}
