<div class="scroll"><table><thead><tr><th>批号</th><th>期初 g</th><th>领用 g</th><th>上件 g</th><th>损耗 g</th><th>回桶 g</th><th>留罐 g</th><th>回桶差 g</th><th>申报</th></tr></thead><tbody>
{% for line in data.balance.lines %}<tr><th scope="row"><span class="swatch swatch-{{ line.lot[:1] }}"></span>{{ line.lot }}</th>{% for k in ('opening_mg','issued_mg','applied_mg','loss_mg','returned_mg','disputed_mg','difference_mg') %}<td class="{{ 'difference' if k=='difference_mg' and line[k] else '' }}">{{ grams(line[k]) }}</td>{% endfor %}<td>{{ labels[line.code] }}</td></tr>{% else %}<tr><td colspan="9">暂无颜料批号。</td></tr>{% endfor %}</tbody></table></div>
