<div class="scroll"><table><thead><tr><th>批号</th><th>期初 g</th><th>领用 g</th><th>上件 g</th><th>损耗 g</th><th>回桶 g</th><th>留罐 g</th><th>回桶差 g</th><th>申报</th></tr></thead><tbody>
{% for line in data.balance.lines %}<tr><th scope="row"><span class="swatch swatch-{{ line.lot[:1] }}"></span>{{ line.lot }}{% if line.provisional %} <span class="provisional" title="同分钟先后不定，重量为可行区间">区间</span>{% endif %}</th>{% for k in ('opening_mg','issued_mg','applied_mg','loss_mg','returned_mg','disputed_mg','difference_mg') %}<td class="{{ 'difference' if k=='difference_mg' and line[k] else '' }}">{% if k=='difference_mg' %}{% if line.provisional and line.difference_range_mg %}{{ grams_span(line.difference_range_mg) }}{% else %}{{ grams(line[k]) }}{% endif %}{% else %}{% if line.range_mg is defined and line.range_mg[k] %}{{ grams_span(line.range_mg[k]) }}{% else %}{{ grams(line[k]) }}{% endif %}{% endif %}</td>{% endfor %}<td>{{ labels[line.code] }}</td></tr>{% else %}<tr><td colspan="9">暂无颜料批号。</td></tr>{% endfor %}</tbody></table></div>
