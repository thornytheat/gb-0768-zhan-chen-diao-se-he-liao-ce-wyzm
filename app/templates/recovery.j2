<section class="panel folio"><div class="folio-head"><h2>回桶成分分摊凭据</h2><label>混料罐 <select id="pot-filter"><option value="all">全部</option>{% for pot in data.recovery.pending_mg %}<option value="{{ pot }}">{{ pot }}</option>{% endfor %}</select></label></div>
<div class="scroll"><table><thead><tr><th>票号 / 罐</th><th>动作</th><th>净重 g</th><th>成分分摊 g</th><th>入罐证据行</th></tr></thead><tbody id="pot-lines">{% for r in data.recovery.rows %}<tr data-pot="{{ r.data.pot }}"><th scope="row">{{ r.data.ticket }} / {{ r.data.pot }}</th><td>{{ actions[r.data.action] }}{% if r.delay %} · 迟补{% endif %}</td><td>{{ grams(r.net_mg) }}</td><td>{% for lot,qty in r.parts_mg.items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %}</td><td>{% for lot,lines in r.issue_lines.items() %}<span class="allocation">{{ lot }} · {{ lines|join(', ') }}</span>{% endfor %}</td></tr>{% endfor %}</tbody></table></div></section>{% include 'rejects.j2' %}
