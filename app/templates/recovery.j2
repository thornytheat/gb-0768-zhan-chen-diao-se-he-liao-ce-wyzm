<section class="panel folio"><div class="folio-head"><h2>回桶成分分摊凭据</h2><label>混料罐 <select id="pot-filter"><option value="all">全部</option>{% for pot in data.recovery.pending_mg %}<option value="{{ pot }}">{{ pot }}</option>{% endfor %}</select></label></div>
{% if data.recovery.ambiguous %}<p class="note">同分钟入罐与出罐先后无原件可辨；下列带区间的分摊是可行范围，不是实数。{% if data.recovery.truncated %}可行方案过多，区间只按预算内抽到的方案给出，实际范围可能更宽。{% endif %}</p>{% endif %}
<div class="scroll"><table><thead><tr><th>票号 / 罐</th><th>动作</th><th>净重 g</th><th>成分分摊 g</th><th>入罐证据行</th></tr></thead><tbody id="pot-lines">{% for r in data.recovery.rows %}<tr data-pot="{{ r.data.pot }}"><th scope="row">{{ r.data.ticket }} / {{ r.data.pot }}</th><td>{{ actions[r.data.action] }}{% if r.delay %} · 迟补{% endif %}{% if r.order_ambiguous %} · 先后不定{% endif %}</td><td>{{ grams(r.net_mg) }}</td><td>{% for lot,qty in r.parts_range_mg.items() %}<span class="allocation">{{ lot }} <b>{{ grams_span(qty) }}</b></span>{% endfor %}</td><td>{% for lot,lines in r.issue_lines.items() %}<span class="allocation">{{ lot }} · {{ lines|join(', ') }}</span>{% endfor %}</td></tr>{% endfor %}</tbody></table></div></section>{% include 'rejects.j2' %}
