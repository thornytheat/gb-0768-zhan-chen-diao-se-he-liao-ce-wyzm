<section class="panel receipt-sheet signed"><div class="receipt-head"><div><p>工坊留存联</p><h2>调色收据证据</h2></div><strong>{{ meta.order }}</strong></div>{% if receipt %}<p>按成分勾稽差额 <b>{{ grams(receipt.mass_check_mg) }} g</b></p>{% if receipt.uncertainty.provisional %}<p class="note">本收据有 {{ receipt.uncertainty.lines|length }} 个批号含先后不定区间，区间内在签发前不作实数；后续回桶沿区间复算。</p>{% endif %}<p>摘要 <code>{{ receipt.sha256 }}</code></p><div class="stub"><a href="{{ url_for('palette.export',key=key) }}">下载证据收据</a></div>{% else %}<p>请先封存工单。</p>{% endif %}</section><section class="panel folio"><h2>签发成分清单</h2>{% include 'balances.j2' %}</section>
