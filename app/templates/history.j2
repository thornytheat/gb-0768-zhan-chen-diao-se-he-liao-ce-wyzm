<section class="panel folio"><h2>封存记录</h2><div class="scroll"><table><thead><tr><th>工单</th><th>留档号</th><th>收存时间 UTC</th><th>耗时 ms</th></tr></thead><tbody>{% for row in history %}<tr><th scope="row">{{ row.order }}</th><td><a href="{{ url_for('studio.desk',screen='receipt',key=row.key) }}">{{ row.key[:18] }}</a></td><td>{{ row.issued_at }}</td><td>{{ row.elapsed_ms }}</td></tr>{% else %}<tr><td colspan="4">先封存一份工单。</td></tr>{% endfor %}</tbody></table></div></section>
