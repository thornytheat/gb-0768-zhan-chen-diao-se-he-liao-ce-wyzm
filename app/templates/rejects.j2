<section class="panel folio rejects"><h2>留待核实</h2><div class="scroll"><table><thead><tr><th>表单 / 行</th><th>原因</th><th>原值</th><th>关联原件</th></tr></thead><tbody>{% for r in rejects %}<tr><th scope="row">{{ r.sheet }} / {{ r.line }}</th><td>{{ labels[r.code] }}</td><td class="clip" title="{{ r.raw|join(' / ') }}">{{ r.raw|join(' / ') }}</td><td>{{ (r.tares|default([])+r.lot_sources|default([]))|map(attribute='line')|join(', ') or '—' }}</td></tr>{% else %}<tr><td colspan="4">无待核记录。</td></tr>{% endfor %}</tbody></table></div></section>
