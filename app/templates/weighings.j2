<section class="panel folio"><h2>秤单收件清点</h2><p>{{ data.weighings.count.source }} 张原件 · {{ data.weighings.count.kept }} 张入册 · {{ data.weighings.count.isolated }} 张隔离</p><div class="scroll"><table><thead><tr><th>票号</th><th>发生时间</th><th>容器</th><th>动作</th><th>毛重</th><th>原件行</th><th>迟补</th></tr></thead><tbody>{% for r in data.weighings.tickets %}<tr><th scope="row">{{ r.data.ticket }}</th><td>{{ studio_label(r.at) }}</td><td>{{ r.data.container }}</td><td>{{ actions[r.data.action] }}</td><td>{{ r.data.gross }} {{ r.data.unit }}</td><td>{{ r.line }}</td><td>{{ '是' if r.delay else '—' }}</td></tr>{% endfor %}</tbody></table></div></section>{% include 'rejects.j2' %}
