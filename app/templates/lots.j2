<section class="panel folio"><h2>领料批次来源</h2><div class="scroll"><table><thead><tr><th>票号</th><th>原写法</th><th>规范批号</th><th>颜料</th><th>净重 g</th><th>登记行</th></tr></thead><tbody>{% for r in data.lots.rows if r.lot %}<tr><th scope="row">{{ r.data.ticket }}</th><td>{{ r.data.lot }}</td><td>{{ r.lot }}</td><td>{{ r.pigment }}</td><td>{{ grams(r.net_mg) }}</td><td>{{ r.lot_sources|map(attribute='line')|join(', ') }}</td></tr>{% endfor %}</tbody></table></div></section>{% include 'rejects.j2' %}
